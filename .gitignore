# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Google service account (SEO report script)
.credentials/

# Analytics CSV exports (latest-report.md is committed when generated)
docs/analytics-reports/*.csv

# Google Ads verification — contains passport / PII (local only)
docs/google-ads-verification/
# Helper that builds the Google Ads verification PDFs (belongs to HypeZone, not OFM)
scripts/build-google-ads-verification-pdf.py

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ECC raw skill sources — keep local, only the curated subset is wired into .claude/skills/
/.cursor/skills/
/.cursor/.agents/
/.agents/skills/

# Claude Code private/local settings (may contain API keys) — committed config is .mcp.json + .claude/skills/
/.claude/settings.local.json

# rank-трекер: история позиций (локальная, не деплоится)
/docs/analytics-reports/rank-history/
