# URL сайта (для SEO, Open Graph, sitemap). На Vercel: https://ваш-домен.vercel.app
NEXT_PUBLIC_SITE_URL=https://ofm-model-agency.vercel.app

# Google Analytics 4 — ID потока данных (Admin → Data streams → Measurement ID)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Telegram Bot — уведомления о заявках с формы сайта
# Настройка (5 мин):
# 1. Telegram → @BotFather → /newbot → имя бота → username → скопируйте TOKEN
# 2. Напишите боту /start (обязательно)
# 3. Откройте в браузере (подставьте TOKEN):
#    https://api.telegram.org/bot<TOKEN>/getUpdates
# 4. Найдите "chat":{"id":123456789} — это TELEGRAM_CHAT_ID
# 5. Добавьте обе переменные в Vercel → Settings → Environment Variables → Redeploy
# Группа: добавьте бота в группу, напишите в группе — id будет отрицательным (например -100...)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# Ссылки на соцсети (меню и подвал сайта)
NEXT_PUBLIC_SOCIAL_TELEGRAM=https://t.me/Azalia_agency
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://instagram.com/your_account
