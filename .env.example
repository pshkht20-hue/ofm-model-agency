# URL сайта (для SEO, Open Graph, sitemap). На Vercel: https://ваш-домен.vercel.app
NEXT_PUBLIC_SITE_URL=https://ofm-model-agency.vercel.app

# Google Analytics 4 — ID потока данных (Admin → Data streams → Measurement ID)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# GA4 Measurement Protocol — серверные конверсии (заявки без cookie consent)
# Admin → Data streams → Measurement Protocol API secrets → Create
GA4_API_SECRET=your_measurement_protocol_secret

# SEO report automation (npm run seo:report) — см. docs/analytics-setup.md
GOOGLE_APPLICATION_CREDENTIALS=.credentials/google-service-account.json
GSC_SITE_URL=sc-domain:ofmmodels.com
GA4_PROPERTY_ID=123456789

# Telegram Bot — уведомления о заявках с формы сайта
# Настройка (5 мин):
# 1. Telegram → @BotFather → /newbot → имя бота → username → скопируйте TOKEN
# 2. Напишите боту /start (обязательно)
# 3. Откройте в браузере (подставьте TOKEN):
#    https://api.telegram.org/bot<TOKEN>/getUpdates
# 4. Найдите "chat":{"id":123456789} — это TELEGRAM_CHAT_ID
# 5. Добавьте обе переменные в Vercel → Settings → Environment Variables → Redeploy
# Группа: добавьте бота в группу, напишите в группе — id будет отрицательным (например -100...)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# --- MCP-интеграции для Claude Code (см. .mcp.json) ---
# DeepL — перевод контента ru/uk/en/es. Ключ: https://www.deepl.com/pro-api (free-tier 500k симв/мес)
# Кладите реальные значения в .claude/settings.local.json (env), а не сюда.
DEEPL_API_KEY=your_deepl_api_key
# DataForSEO — данные по ключам/SERP/беклинкам. Логин/пароль: https://app.dataforseo.com (pay-per-request)
DATAFORSEO_USERNAME=your_dataforseo_login
DATAFORSEO_PASSWORD=your_dataforseo_password

# Ссылки на соцсети (меню и подвал сайта)
NEXT_PUBLIC_SOCIAL_TELEGRAM=https://t.me/ofmm_agency
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://instagram.com/your_account
